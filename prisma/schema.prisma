datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator db {
  provider = "go run github.com/steebchen/prisma-client-go"
}

model Contract {
  id             String         @id @default(uuid())
  chainId        Int
  eventName      String
  address        String
  eventSignature String
  startBlock     Int
  eventABI       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  eventLogs      EventLog[]
  subscriptions  Subscription[]

  @@unique([chainId, address, eventSignature])
  @@unique([chainId, eventName, address])
  @@index([chainId, eventName, address])
}

model EventLog {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  blockNumber Int
  txHash      String
  logIndex    Int
  data        String
  createdAt   DateTime @default(now())

  @@index([contractId, blockNumber])
  @@index([txHash])
}

model Subscription {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  clientId   String
  createdAt  DateTime @default(now())
  lastPing   DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([contractId, clientId])
  @@index([clientId])
}

model KeyValue {
  key   String @id
  value Bytes
}

// StorageKV represents the key-value storage for trie nodes
model StorageKV {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Bytes    // Using Bytes type for binary data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// CodeStorage represents the storage for code by hash
model CodeStorage {
  id        String   @id @default(cuid())
  hash      String   @unique // Hash of the code
  code      Bytes    // The actual code bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hash])
}
